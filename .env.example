# ---- Frontend (Netlify → Site settings → Environment variables) ----
# Supabase project URL: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon / publishable key (safe for the browser). NEVER put the service-role key here.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Optional: the public address printed into QR codes (defaults to the current site address)
VITE_PUBLIC_SITE_URL=https://your-site.netlify.app
