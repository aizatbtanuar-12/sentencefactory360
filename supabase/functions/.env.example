# ---- Edge Function secrets (set with: supabase secrets set --env-file supabase/functions/.env) ----
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.

# The teacher PIN used for the very first login (4–8 digits). Change it in Teacher Zone → Settings afterwards.
INITIAL_TEACHER_PIN=CHANGE-ME
# Long random string used to sign teacher sessions. Generate with: openssl rand -hex 32
TEACHER_SESSION_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING
# Comma-separated list of allowed site origins for CORS (your Netlify URL, plus localhost for development)
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5173
